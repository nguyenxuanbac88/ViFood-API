# ==============================================================
# default.conf.template — Nginx config với biến môi trường
#
# Nginx Docker image tự động xử lý file này khi container start:
#   /etc/nginx/templates/*.template → envsubst → /etc/nginx/conf.d/*.conf
#
# Biến được inject từ .env (qua docker-compose env_file):
#   ${DOMAIN}  — domain thực của bạn, VD: api.vifood.com
#
# LƯU Ý: Nginx variables ($host, $remote_addr...) phải viết $$
#   để envsubst không thay thế nhầm → sau xử lý $$ trở thành $
# ==============================================================

# Docker internal DNS — resolve upstream theo tên service lúc có request
# (không resolve tại startup → tránh lỗi "host not found" khi Nginx start trước api)
resolver 127.0.0.11 valid=10s ipv6=off;

# ==============================================================
# Catch-all — chặn truy cập trực tiếp bằng IP (không khớp domain)
# Trả về 444: Nginx đóng kết nối ngay, không gửi response
# (443 catch-all thêm vào sau khi có SSL)
# ==============================================================
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    return 444;
}

# ==============================================================
# HTTP — port 80
# Giai đoạn 1 (chưa có SSL): proxy thẳng vào API
# Giai đoạn 2 (có SSL)     : redirect 301 → HTTPS
# ==============================================================
server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN};

    # Let's Encrypt ACME challenge
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # --- Giai đoạn 1: chưa có SSL ---
    # Xóa block location này và bỏ comment "return 301" bên dưới khi đã có SSL
    location / {
        proxy_pass         http://api:8000;
        proxy_http_version 1.1;
        proxy_set_header   Upgrade           $http_upgrade;
        proxy_set_header   Connection        "upgrade";
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    # --- Giai đoạn 2: bật khi có SSL ---
    # return 301 https://${DOMAIN}$$request_uri;
}

