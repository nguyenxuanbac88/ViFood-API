# ==============================================================
# .env.example — Template biến môi trường
# SAO CHÉP file này thành .env và điền giá trị thực
#   cp .env.example .env
# KHÔNG commit file .env lên git
# ==============================================================

# ---- API Info ----
APP_NAME="ViFood API"
APP_VERSION="1.0.0"
APP_DESCRIPTION="ViFood - Food & Nutrition API"
DEBUG=false

# ---- Server ----
HOST=0.0.0.0
PORT=8000

# ---- Neo4j Database ----
# Local (không dùng Docker Compose): bolt://localhost:7687
# Trong Docker Compose:             bolt://neo4j:7687
# Neo4j Aura (cloud):               neo4j+s://<instance-id>.databases.neo4j.io
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_strong_password_here
NEO4J_DATABASE=neo4j

# ---- MongoDB Scan History ----
# Local MongoDB: mongodb://localhost:27017
# Docker Compose: mongodb://mongodb:27017
# MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=vifood
MONGODB_SCAN_HISTORY_COLLECTION=scan_history

# ---- JWT / Security ----
# Tạo SECRET_KEY ngẫu nhiên: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_secret_key_here_change_this_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- CORS ----
# Production: thay ["*"] bằng domain thực, ví dụ: ["https://vifood.com"]
ALLOWED_ORIGINS=["*"]
ALLOWED_METHODS=["*"]
ALLOWED_HEADERS=["*"]

# ---- Upload ----
# Đường dẫn thư mục lưu file upload (relative to project root)
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760

# ---- URL & Domain ----
# ==============================================================
# Ý nghĩa từng biến domain:
# DOMAIN       → domain CHÍNH cho API (không kèm giao thức)
# NEO4J_DOMAIN → subdomain cho Neo4j Browser (không kèm giao thức)
# BASE_URL     → URL đầy đủ của API (có https://), dùng trong response/app config
#
# Ví dụ production (khuyên dùng):
#   DOMAIN=api.dvxuanbac.com
#   NEO4J_DOMAIN=neo4j.dvxuanbac.com
#   BASE_URL=https://api.dvxuanbac.com
#
# Khi chỉ dùng IP (chưa có domain):
#   DOMAIN=_         ← Nginx nhận mọi request
#   NEO4J_DOMAIN=_   ← Tạm thời không tách host Neo4j
#   BASE_URL=http://103.x.x.x
# ==============================================================
DOMAIN=your-domain.com
NEO4J_DOMAIN=neo4j.your-domain.com
BASE_URL=https://your-domain.com
API_PREFIX=/api
KG_BUILDER_API_URL=http://localhost:8002
KG_BUILDER_ANALYZE_PATH=/labels/analyze

# ---- Docker (production only — set tự động bởi deploy.sh) ----
# VIFOOD_IMAGE=yourdockeruser/vifood-api:sha-a1b2c3d
# DOCKER_USERNAME=yourdockeruser

# ---- Feature Flags ----
PRODUCTS_DEFAULT_VERSION=v0
PRODUCTS_CANARY_ENABLED=false
PRODUCTS_CANARY_PERCENT=0
PRODUCTS_CANARY_TARGET_VERSION=v1

# ---- AWS S3 ----
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=name-of-your-s3-bucket
